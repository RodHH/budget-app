# Copy to .env (next to package.json) or set these in your host's environment settings.
# Never paste these values into chat or into the app itself.

# Public HTTPS address of this app, e.g. https://budget.your-tailnet.ts.net
# Needed for iPhone push notifications, secure cookies and Plaid webhooks.
PUBLIC_URL=

# --- Plaid (bank connections). Get keys at https://dashboard.plaid.com/developers/keys
PLAID_ENV=sandbox            # sandbox while testing, production for real banks
PLAID_CLIENT_ID=
PLAID_SECRET=                # use the secret that matches PLAID_ENV
# Optional, recommended for OAuth banks (Chase, etc.). Must also be added under
# Plaid Dashboard > Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=          # e.g. https://budget.your-tailnet.ts.net/oauth-return

# --- Web push. Keys are generated automatically on first start; only the contact is required.
VAPID_SUBJECT=               # e.g. mailto:you@example.com (Apple rejects pushes without a real one)

# --- Optional
PORT=8080
DATA_DIR=./data              # database, daily backups and encryption key live here
# APP_ENCRYPTION_KEY=        # 32 random bytes, base64. Default: generated into DATA_DIR/encryption.key
# SETUP_CODE=                # fixed first-run setup code; default: random, printed in the log
# TRUST_PROXY=1              # set when behind a reverse proxy, for accurate rate limiting
